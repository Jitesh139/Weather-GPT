# === LLM provider keys ===
# Required for the SLOW path (two-stage generator/verifier pipeline).
# The FAST path works with these unset (no LLM calls on that path).
# Get an Anthropic key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Google Weather API (optional second data source) ===
# When set, every weather answer combines Open-Meteo with the Google
# Weather API (weather.googleapis.com) and reports a blended "best
# estimate" alongside both raw readings. Purely additive - if unset,
# answers use Open-Meteo alone, exactly as before. Get a key (with the
# "Weather API" enabled) at https://console.cloud.google.com/
GOOGLE_WEATHER_API_KEY=

# === Database ===
# Matches the postgres service in docker-compose.yml by default.
# Only change this if you're running Postgres somewhere else.
DATABASE_URL=postgresql://weathergpt:weathergpt@postgres:5432/weathergpt

# === Cache ===
# How long a fetched forecast is served from cache before a fresh
# Open-Meteo call is made, in seconds. Spec recommends 10-15 minutes.
CACHE_TTL_SECONDS=900

# === Logging ===
# debug | info | warning | error
LOG_LEVEL=info

# === LLM provider/model routing (NOT finalized per spec Section 14 -
# implemented behind a swappable LLMClient interface; this is a
# reasonable default, not a locked-in decision) ===
# Which provider runs the Stage 1 generator: "claude" or "gemini"
GENERATOR_PROVIDER=claude
# Which provider runs the Stage 2 verifier: "claude" or "gemini"
VERIFIER_PROVIDER=gemini
# Model used by the generator (only used if GENERATOR_PROVIDER=claude)
GENERATOR_MODEL=claude-opus-5
# Model used by the verifier (only used if VERIFIER_PROVIDER=gemini)
# Confirmed working against the live Gemini API during development.
VERIFIER_MODEL=gemini-3.6-flash

# === Voice layer (spec Section 7) ===
# "web_speech" (default): browser-side STT/TTS, zero backend config needed.
# "bhashini": routes voice through Bhashini's ASR/TTS pipeline instead -
# requires BHASHINI_USER_ID/BHASHINI_API_KEY below. NOT verified against a
# real Bhashini account in this build (no credentials were available) -
# the integration follows Bhashini's own documented API contract
# (bhashini.gitbook.io/bhashini-apis) but has not been run end-to-end.
# "google": routes voice through Gemini instead - ASR via the Live API's
# translate model, TTS via Gemini's native TTS model. Only needs
# GEMINI_API_KEY above (no separate signup) - use this if Bhashini isn't
# available to you.
VOICE_PROVIDER=web_speech
# Register at https://bhashini.gov.in/ulca/user/register, then generate
# a key from "My Profile" to get these two values.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Community-referenced default pipeline ID for standard ASR+TTS - NOT
# independently confirmed against your account's available pipelines.
# Verify via the Bhashini portal / Pipeline Search API and override if needed.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# ISO-639 language code (e.g. hi, ta, te, bn, en). Bhashini's model
# catalog is Indian-language-focused - English ASR/TTS coverage is not
# guaranteed; check the pipeline config response for what's supported.
BHASHINI_LANGUAGE=hi
# male | female
BHASHINI_TTS_GENDER=female

# Only used when VOICE_PROVIDER=google. Defaults are current as of this
# build - Google's live/preview model names change over time, so verify
# against https://ai.google.dev/gemini-api/docs/models if voice requests
# start failing with a "model not found" error.
GOOGLE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
